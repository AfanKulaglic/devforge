{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "NODE_OPTIONS=--max-old-space-size=4096 npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/reklama",
      "destination": "/index.html"
    },
    {
      "source": "/o-nama",
      "destination": "/index.html"
    },
    {
      "source": "/usluge",
      "destination": "/index.html"
    },
    {
      "source": "/usluge/web-stranice",
      "destination": "/index.html"
    },
    {
      "source": "/usluge/2d-igrice",
      "destination": "/index.html"
    },
    {
      "source": "/usluge/mobilne-aplikacije",
      "destination": "/index.html"
    },
    {
      "source": "/usluge/ai-sistemi",
      "destination": "/index.html"
    },
    {
      "source": "/projekti",
      "destination": "/index.html"
    },
    {
      "source": "/cijene",
      "destination": "/index.html"
    },
    {
      "source": "/cesta-pitanja",
      "destination": "/index.html"
    },
    {
      "source": "/kontakt",
      "destination": "/index.html"
    },
    {
      "source": "/privatnost",
      "destination": "/index.html"
    },
    {
      "source": "/uslovi",
      "destination": "/index.html"
    },
    {
      "source": "/kolacici",
      "destination": "/index.html"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ],
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(og-image|hero-3d).png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/site.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/reklama",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
